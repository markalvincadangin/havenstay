# Copy this file to db/replica_daily_start.env and fill your local values.
# This file is safe to commit. The real db/replica_daily_start.env is ignored.

# Optional executable paths
# MYSQL_EXE=C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysql.exe
# MYSQLD_EXE=C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysqld.exe
# REPLICA_DEFAULTS_FILE=C:/laragon/bin/mysql/mysql-8.4.3-winx64/my-replica.ini

# Topology
SOURCE_HOST=127.0.0.1
SOURCE_PORT=3306
REPLICA_HOST=127.0.0.1
REPLICA_PORT=3307

# Daily behavior
START_REPLICA_IF_DOWN=true
REPLICA_START_WAIT_SECONDS=15
AUTO_RESEED_ON_1236=false
RESEED_DATABASES=havenstay
RESEED_DUMP_FILE=C:/laragon/tmp/havenstay_reseed.sql

# Admin user used for SHOW/STOP/RESET/START REPLICA
REPLICA_ADMIN_USER=root
REPLICA_ADMIN_PASSWORD=

# Replication channel user used in CHANGE REPLICATION SOURCE TO
REPL_USER=replica
REPL_PASSWORD=

# Optional: explicit mysqldump binary path
# MYSQLDUMP_EXE=C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysqldump.exe
