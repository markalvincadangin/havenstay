# ============================================================
# HavenStay BHMS — Root Environment Configuration
# ============================================================
# Copy to `.env` before starting Docker Compose:
#   cp .env.example .env
#
# ⚠ CHANGE PASSWORDS BEFORE PRODUCTION DEPLOYMENT
# ============================================================

# --- DATABASE (MySQL 8.4 Primary & Replica) ---
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=havenstay_db
MYSQL_USER=replica_user
MYSQL_PASSWORD=replica_pass

# --- BACKEND (Laravel 13 API) ---
APP_NAME=HavenStay
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:hWXurcwNFyI1ySTdsK8mAxcYUn7VyB3P3fbcNXA8iQw=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=*.trycloudflare.com,*.ngrok-free.app,localhost:3000,127.0.0.1:3000

DB_CONNECTION=mysql
DB_HOST=db-primary
DB_PORT=3306
DB_DATABASE=havenstay_db
DB_USERNAME=root
DB_PASSWORD=changeme_root_password
DB_WRITE_HOST=db-primary
DB_WRITE_PORT=3306
DB_READ_HOST=db-replica
DB_READ_PORT=3306
DB_STICKY=true

# Database Seeding:
# true  = run safe migrate and seed initial admin & demo scenarios
# false = run safe migrate only (preserves existing data)
DB_SEED=true

# --- FRONTEND (Next.js 16 SPA) ---
NEXT_PUBLIC_API_BASE_URL=
BACKEND_INTERNAL_URL=http://backend:80
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
DEMO_MODE=true

# --- HOST PORT MAPPINGS ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=3306
DB_REPLICA_PORT=3307

# --- STANDALONE PRODUCTION PORTS (docker-compose.prod.yml) ---
PROD_FRONTEND_PORT=3000
PROD_BACKEND_PORT=8000
PROD_DB_PRIMARY_PORT=3306
PROD_DB_REPLICA_PORT=3307
