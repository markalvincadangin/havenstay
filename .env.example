# ============================================================
# HavenStay BHMS — Root Environment Variables
# ============================================================
# Copy to .env and fill in values. Used by docker-compose.yml.
# Service-specific configs remain in backend/.env and frontend/.env.local
#
# ⚠ CHANGE ALL PASSWORDS BEFORE USE — defaults are placeholders only.
# ============================================================

# --- DATABASE (Primary) ---
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=havenstay_db
MYSQL_USER=replica_user
MYSQL_PASSWORD=changeme_replica_password

# --- BACKEND ---
APP_ENV=local
APP_DEBUG=true
DB_CONNECTION=mysql
DB_HOST=db-primary
DB_PORT=3306
DB_DATABASE=havenstay_db
DB_USERNAME=root
DB_PASSWORD=changeme_root_password
DB_WRITE_HOST=db-primary
DB_WRITE_PORT=3306
DB_READ_HOST=db-replica
DB_READ_PORT=3306
DB_STICKY=true
DB_SEED=true

# --- FRONTEND ---
NEXT_PUBLIC_API_BASE_URL=
BACKEND_INTERNAL_URL=http://backend:80
