{
  "project_standards": {
    "framework": "Laravel 11 (PHP 8.3+)",
    "database": "MySQL 8.4+ (Forensic Hardened Schema v5.0)",
    "architecture": "5-Tier Extended MVC: Middleware → Controller → Service → Model/Support → Database",
    "forensics": "45-Trigger Audit Engine | 15 Normalized Tables | 6 Reporting Views"
  },
  "business_logic_mandates": {
    "reservation_lock": "CRITICAL: Bed space status must transition to 'occupied' immediately upon contract creation (even if contract status is 'pending_payment') to prevent double-booking. (Ref: BR-CON-002)",
    "utility_traceability": "All utility billing line items must physically link to a meter reading via 'reading_id' and 'utility_id'. (Ref: BR-MET-009)",
    "financial_xor": "Payments must link to either a billing cycle OR a contract, never both. (Ref: chk_pay_target / BR-PAY-002)",
    "soft_deletes": "Soft-deletes must use virtual unique keys (active_email/active_username) to allow re-registration of archived profiles.",
    "dual_path_payments": "Payment context resolution is dual-path: Rent payments link via billing->contract->tenant; Deposit payments link directly via contract->tenant. All payment UI/API logic must traverse both paths. (Ref: BR-PAY-011)",
    "resilient_batch": "Room-level batch billing must be non-blocking. Trap per-contract validation failures in try-catch, log the failure, and continue processing remaining contracts. (Ref: BR-BIL-010)",
    "transaction_logs_retired": "DECOMMISSIONED: transaction_logs table and TransactionService are retired. Do not reference or reintroduce them. All forensics are handled by audit_logs + AuditService + 45 DB triggers."
  },
  "code_generation_rules": {
    "controllers": [
      "Keep controllers strictly for request/response handling.",
      "Inject services for all business logic.",
      "Use FormRequests for validation.",
      "Call AuthorizationService::ensure*() before any action — never use raw role checks.",
      "Return data via API Resource classes (app/Http/Resources/), never raw toArray().",
      "Enforce Idempotency-Key header on all financial/contractual POST/PUT/PATCH endpoints."
    ],
    "services": [
      "All write operations MUST use self::runWriteWorkflow() from ManagesWorkflows trait.",
      "System/CLI contexts (seeders, artisan) must call AuditService::setSystemContext() before writes.",
      "Throw ValidationException for Business Rule violations — never swallow Throwable.",
      "Room context is derived via bed space: $contract->bedSpace->room_id — contracts have no room_id column.",
      "Temporal utility rate lookups MUST use billing_period_from date, never now()."
    ],
    "models": [
      "Keep models anemic (properties and relationships only).",
      "Use Enum casting for statuses.",
      "Define relationships using strict type hints and explicit foreign keys.",
      "Use decimal:2 casting for all monetary fields."
    ],
    "migrations": [
      "Do not modify columns directly; use forensic-safe ALTER or sync with havenstay_schema.sql.",
      "Any schema change must be applied to BOTH db/havenstay_schema.sql AND backend/database/sql/havenstay_schema.sql simultaneously."
    ]
  },
  "nomenclature": {
    "utility_registry": "utilities / utility_rates (rate creation: POST /api/utilities/rates — NOT /api/utility-rates)",
    "meter_management": "meters / meter_assignments / meter_readings",
    "human_entities": "tenants (NOT boarders) / users",
    "styling": "Vanilla CSS with hs-* utility classes — NOT Tailwind CSS"
  }
}
