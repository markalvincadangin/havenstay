# ============================================================
# Docker Compose Override — Local Development Customizations
# ============================================================
# Copy this file to `docker-compose.override.yml` (which is gitignored).
# Docker Compose will automatically merge this file with `docker-compose.yml`.
#
# Use this file for machine-specific overrides without editing git-tracked files.
# ============================================================

services:
  # Example: If running on Windows / WSL2 with high CPU or missed file changes,
  # enable polling for Next.js file watcher:
  # frontend:
  #   environment:
  #     - WATCHPACK_POLLING=true
  #     - CHOKIDAR_USEPOLLING=true

  # Example: Change host port bindings if 3000, 8000, or 3306 conflict on your host:
  # frontend:
  #   ports:
  #     - "3001:3000"
  # backend:
  #   ports:
  #     - "8001:80"
  # db-primary:
  #   ports:
  #     - "3308:3306"
