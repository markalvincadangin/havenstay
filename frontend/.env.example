# Frontend public runtime configuration (safe template)
# Leave empty so the browser uses same-origin /api/* (Next rewrites to Laravel — see next.config.mjs).
# Set only if the SPA must call Laravel directly (cross-origin), e.g. NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=
# Where Next.js proxies /api (server-side only; not exposed to the browser). Local: Laravel on host.
# Docker Compose sets this to http://backend at image build time.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
