# ─────────────────────────────────────────────────────────────────────────────
# HavenStay Frontend — Environment Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local, then uncomment the profile that matches your setup.
# See .env.local for full documentation.
# ─────────────────────────────────────────────────────────────────────────────

# Profile A: Standard local dev (default). Leave NEXT_PUBLIC_API_BASE_URL empty
# so the browser uses same-origin /api/* rewrites (see next.config.mjs).
NEXT_PUBLIC_API_BASE_URL=
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Profile B: Port-forwarding / tunnel dev (ngrok, Cloudflare Tunnel).
# Set BACKEND_INTERNAL_URL to your tunnel URL and add your frontend tunnel
# host to ALLOWED_DEV_ORIGINS (comma-separated, no protocol).
# BACKEND_INTERNAL_URL=https://your-backend-tunnel.ngrok-free.app
# ALLOWED_DEV_ORIGINS=your-frontend-tunnel.ngrok-free.app
