# Frontend public runtime configuration (safe template)
# Leave empty for same-origin /api (Next rewrites to Laravel) — use for TestSprite/tunnels.
# Or set direct API: http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=
# Optional: where Next.js proxies /api (server-side). Default http://127.0.0.1:8000
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
