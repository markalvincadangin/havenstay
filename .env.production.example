# ============================================================
# HavenStay BHMS — Production Environment Configuration (.env.production)
# ============================================================
# Copy this file to .env on your production VPS:
#   cp .env.production.example .env
# Then fill in your domain name, email, and strong random passwords.
# ============================================================

# ── PUBLIC DOMAIN & TLS (Caddy Reverse Proxy) ──
# If using a domain: set DOMAIN_NAME=havenstay.yourdomain.com (Caddy issues free Let's Encrypt SSL)
# If using raw IP without a domain: set DOMAIN_NAME=:80 (Serves over HTTP on port 80)
DOMAIN_NAME=:80
ACME_EMAIL=your-email@example.com
HTTP_PORT=80
HTTPS_PORT=443

# ── APPLICATION CORE ──
APP_NAME=HavenStay
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Generate with: docker compose exec backend php artisan key:generate --show
APP_KEY=base64:GENERATE_PRODUCTION_KEY_HERE

# Production Public URLs (used for email links, redirects, and CORS)
APP_URL=http://localhost
FRONTEND_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost

# ── LOGGING ──
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── DATABASE CREDENTIALS (MySQL 8.4 GTID Primary & Replica) ──
DB_CONNECTION=mysql
DB_DATABASE=havenstay_db
DB_HOST=db-primary
DB_WRITE_HOST=db-primary
DB_READ_HOST=db-replica
DB_PORT=3306
DB_REPLICA_PORT=3306
DB_STICKY=true

# Database users & passwords (replace with strong random strings!)
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=havenstay_db
MYSQL_USER=havenstay_user
MYSQL_PASSWORD=replace_with_strong_app_password
DB_USERNAME=havenstay_user
DB_PASSWORD=replace_with_strong_app_password

# Database seeding behavior:
# Set to 'true' on first boot to seed roles, admin users, and demo rooms.
# The entrypoint automatically detects existing records and skips re-seeding safely.
DB_SEED=true
DB_FRESH=false

# ── FRONTEND NEXT.JS CONFIGURATION ──
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
BACKEND_INTERNAL_URL=http://backend:80
NEXT_PUBLIC_API_BASE_URL=

# ── PORTFOLIO DEMO SANDBOX ──
# Set to 'true' to display 1-click role login buttons and role badges for portfolio reviewers.
# Set to 'false' to strip demo buttons and enable strict commercial production auth.
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
DEMO_MODE=true

# ── CACHE & SESSION (Native File / Redis) ──
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
