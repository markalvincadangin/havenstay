# Copy to .env.testing (gitignored). Used when APP_ENV=testing (phpunit / Pest).
# Default: phpunit.xml forces SQLite via PHPUnit env; no MySQL vars needed for SQLite CI.
#
# For MySQL evidence runs: composer test:mysql
#   - phpunit.mysql.xml does NOT set DB_*; Laravel loads this file when APP_ENV=testing.
#   - Generate APP_KEY: php artisan key:generate --show
#   - Create database: CREATE DATABASE havenstay_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

APP_ENV=testing
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_WRITE_HOST=127.0.0.1
DB_WRITE_PORT=3306
DB_READ_HOST=127.0.0.1
DB_READ_PORT=3306
DB_STICKY=false
DB_DATABASE=havenstay_test
DB_USERNAME=root
DB_PASSWORD=
DB_URL=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
