APP_NAME=HavenStay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend origin — used for CORS and Sanctum stateful domain allowlist.
# Local dev: http://localhost:3000
# Tunnel dev: your ngrok/cloudflare frontend URL (e.g. https://xyz.ngrok-free.app)
FRONTEND_URL=http://localhost:3000

# Comma-separated list of domains that may send stateful (cookie) requests.
# For tunnel dev, add your frontend tunnel domain (no protocol, no trailing slash).
# Example: SANCTUM_STATEFUL_DOMAINS=localhost:3000,xyz.ngrok-free.app
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=havenstay_db
# DB_USERNAME=root
# DB_PASSWORD=

# MySQL source/replica (set DB_CONNECTION=mysql). Order: migrate on primary with DB_READ_PORT=3306, sync replica,
# then set DB_READ_PORT=3307. See docs/DISTRIBUTED_DB_SETUP.md.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_WRITE_HOST=127.0.0.1
# DB_WRITE_PORT=3306
# DB_READ_HOST=127.0.0.1
# DB_READ_PORT=3306
# DB_DATABASE=havenstay
# DB_USERNAME=<your_db_user>
# DB_PASSWORD=<your_db_password>
# DB_STICKY=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
