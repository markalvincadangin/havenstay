# Dependencies - rebuilt inside container
vendor

# Environment files - injected at runtime via docker-compose / secrets
.env
.env.local
.env.testing
.env.docker

# Local database artifacts (never bake host sqlite files into container)
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite3
database/*.sqlite3-journal

# Temporary test caches
.phpunit.result.cache

# Dev / tooling artifacts
.git
.gitignore
*.md
debug_output.txt
scratch_debug_*.php

# Node artifacts
node_modules

# Laravel runtime storage artifacts
storage/logs/*
!storage/logs/.gitignore
storage/framework/cache/*
!storage/framework/cache/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/debugbar

# IDE / Editor configs
.idea
.vscode
.phpstorm.meta.php
_ide_helper*.php
